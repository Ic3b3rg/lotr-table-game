{
  "name": "lotr-table-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/host.mjs",
    "prototype": "node scripts/prototype.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src scripts tests package.json tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/qrcode": "1.5.6",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
